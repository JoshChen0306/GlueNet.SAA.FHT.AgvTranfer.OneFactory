<div class="col-lg-12 main-chart">
    <h4><strong>@Localizer["Map"]</strong></h4>
    <div class="mb-4" id="Map"></div>
    <div class="row">
        <div class="col-5">
            <form id="DispatchForm">
                <h4><strong>@Localizer["Dispatch"]</strong></h4>
                <div class="row mb-3">
                    <label class="col-2 col-form-label">@Localizer["Area"]</label>
                    <div class="col-10">
                        <select class="form-select w-75" name="Area" id="Area" asp-items=@ViewBag.AreaList required>
                            <option value="" class="text-secondary" disabled selected hidden>@Localizer["AreaText"]</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-2 col-form-label">@Localizer["BeginStation"]</label>
                    <div class="col-10">
                        <select class="form-select w-75 Site" name="BegingStation" id="BeginStation" asp-items=@ViewBag.Site required>
                            <option value="" disabled selected hidden>@Localizer["StationText"]</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-2 col-form-label">@Localizer["EndStation"]</label>
                    <div class="col-10">
                        <select class="form-select w-75 Site" name="EndStation" id="EndStation" asp-items=@ViewBag.Site required>
                            <option value="" disabled selected hidden>@Localizer["StationText"]</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-2 col-form-label">Rack碼</label>
                    <div class="col-10 d-flex align-items-center">
                        <input class="form-control me-3 w-75" id="RackId" name="RackId" placeholder="Rack編碼" readonly />
                    </div>
                </div>
                <div class="row position-relative mb-3">
                    <label class="col-2 col-form-label">@Localizer["WorkOrder"]</label>
                    <div class="col-10 d-flex align-items-center">
                        <input class="form-control w-75 me-2" id="WorkOrder" name="WorkOrder" autocomplete="off" placeholder="@Localizer["BatchText"]" />
                        <i class="fa-solid fa-qrcode fa-xl position-absolute" style="right:22.5%;color:gray;"></i>
                    </div>
                </div>
                <div class="row position-relative">
                    <label class="col-2 col-form-label"></label>
                    <div class="col-8 d-flex align-items-center justify-content-end">
                        @if (ViewBag.Role == "5")
                        {
                            <a class="btn btn-success rounded-pill me-4" id="UnloadButton" role="button">@Localizer["UnloadFinish"]</a>
                        }
                        else if (ViewBag.Role == "6" || ViewBag.Role == "1")
                        {
                            <a class="btn btn-primary rounded-pill me-3 ConfirmButton" id="ConfirmButton" role="button">@Localizer["Submit"]</a>
                            <a class="btn btn-secondary rounded-pill me-3 ConfirmButton" id="ChangeButton" role="button">@Localizer["Change"]</a>
                            <a class="btn btn-success rounded-pill me-4 ConfirmButton" id="RejectdButton" role="button">@Localizer["Reject"]</a>
                        }
                        else
                        {
                            <a class="btn btn-primary rounded-pill me-3 ConfirmButton" id="ConfirmButton" role="button">@Localizer["Submit"]</a>
                        }
                    </div>
                </div>
            </form>
        </div>
        <div class="col-7">
            <h4><strong>@Localizer["Tasks"]</strong></h4>
            <div class="maintain-table maintain-table-small">
                <table class="table mt-3">
                    <thead class="text-center">
                        <tr>
                            <th class="text-secondary">#</th>
                            <th class="text-secondary">@Localizer["BeginStation"]</th>
                            <th class="text-secondary">@Localizer["EndStation"]</th>
                            <th class="text-secondary">@Localizer["Batch"]</th>
                            <th class="text-secondary">@Localizer["Status"]</th>
                            <th class="text-secondary">@Localizer["Action"]</th>
                        </tr>
                    </thead>
                    <tbody class="text-center" id="DispatchStatus">
                        <Partial name="_DispatchPartial.cshtml"></Partial>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @* Modal視窗 *@
    <div class="modal fade" id="dispatchModalToggle" aria-hidden="true" aria-labelledby="dispatchModalToggleLabel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="dispatchModalToggleLabel"><strong>確認派車</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    是否派送任務
                </div>
                <div class="modal-footer">
                    <button type="button" class="SubmitButton btn btn-primary rounded-pill" data-bs-target="#dispatchModalToggle2" data-bs-toggle="modal">@Localizer["Submit"]</button>
                    <button type="button" class="btn btn-danger rounded-pill" data-bs-dismiss="modal">取消</button>
                </div>
            </div>
        </div>
    </div>
    @*下料完成*@
    <div class="modal fade" id="unloadModalToggle" aria-hidden="true" aria-labelledby="unloadModalToggleLabel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="unloadModalToggleLabel"><strong>確認站點</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    站點是否下料完成
                </div>
                <div class="modal-footer">
                    <button type="button" class="SubmitButton btn btn-primary rounded-pill" data-bs-target="#dispatchModalToggle2" data-bs-toggle="modal">@Localizer["Submit"]</button>
                    <button type="button" class="btn btn-danger rounded-pill" data-bs-dismiss="modal">取消</button>
                </div>
            </div>
        </div>
    </div>
    @*退貨選擇*@
    <div class="modal fade" id="RejectModalToggle" aria-hidden="true" aria-labelledby="RejectModalToggleLabel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="RejectModalToggleLabel"><strong>退貨選擇</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="col-2 col-form-label">狀態選擇</label>
                    <div class="col-10">
                        <select class="form-select w-75 " name="Status" id="Status" required>
                            <option value="1">空盤</option>
                            <option value="3">料盤</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="SubmitButton btn btn-primary rounded-pill" data-bs-dismiss="modal">@Localizer["Submit"]</button>
                    <button type="button" class="btn btn-danger rounded-pill" data-bs-dismiss="modal">取消</button>
                </div>
            </div>
        </div>
    </div>
    @* 帳密驗證 *@
    <div class="modal fade" id="ReLoginModalToggle" aria-hidden="true" aria-labelledby="ReLoginModalToggleLabel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ReLoginModalToggleLabel"><strong>帳號驗證</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-10">
                        <div class="row mb-3">
                            <label class="col-2 col-form-label">帳號:</label>
                            <div class="col-10 d-flex align-items-center">
                                <input class="form-control me-3 w-75" id="userId" name="userId" placeholder="帳號" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-2 col-form-label">密碼:</label>
                            <div class="col-10 d-flex align-items-center">
                                <input class="form-control me-3 w-75" type="password" id="password" name="password" placeholder="密碼" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary rounded-pill" id="reLoginButton" data-bs-dismiss="modal">@Localizer["Submit"]</button>
                    <button type="button" class="btn btn-danger rounded-pill" data-bs-dismiss="modal">取消</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="dispatchModalToggle2" aria-hidden="true" aria-labelledby="dispatchModalToggleLabel2" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="dispatchModalToggleLabel2"><strong>確認派車</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    派送成功
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                </div>
            </div>
        </div>
    </div>
    @* 取消任務 *@
    <div class="modal fade" id="cancleModal" aria-hidden="true" aria-labelledby="cancleModalToggleLabel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cancleModalToggleLabel"><strong>取消任務</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    確認取消任務
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary rounded-pill" id="CancleButton">@Localizer["Submit"]</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="module" src="~/js/Map.js"></script>
    <script type="module" src="~/js/dispatch.js"></script>
}
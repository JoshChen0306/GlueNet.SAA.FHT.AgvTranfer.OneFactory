    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div class="col-lg-12 main-chart">
    <div class="bg-white d-flex flex-column" style="height:800px;">
        <div>
            <ul class="nav nav-tabs">
                @{
                    var allowedFloors = ViewBag.AllowedFloors as List<string> ?? new List<string>();
                    var floorDisplayNames = ViewBag.FloorDisplayNames as Dictionary<string, string>
                        ?? new Dictionary<string, string>();
                    foreach (var area in allowedFloors)
                    {
                        var f = area.Replace("FHT1-", "");
                        var displayName = floorDisplayNames.ContainsKey(area) ? floorDisplayNames[area] : f;
                        var isActive = ViewBag.CurrentFloor == f;
                        <li class="nav-item">
                            <a class="nav-link @(isActive ? "active" : "")" href="/Port?floor=@f">@displayName</a>
                        </li>
                    }
                }
            </ul>
        </div>
        
        <div class="d-flex align-items-center justify-content-center flex-grow-1">
            <div class="mx-auto d-block position-relative">
                <img src="@ViewBag.MapImage" height="500" class="d-block mw-100" style="object-fit: cover;">
                @foreach (var style in ViewBag.positions)
                {
                    <button class="btn position-absolute p-0 border-0" id="@style.Name" data-bs-toggle="modal" data-bs-target="#portModal" data-machinename="@style.MachineName" data-interfacename="@style.InterfaceName" data-useflag="@style.UseFlag" data-haveflag="@style.HaveFlag" data-workorder="@style.WorkOrder" style='bottom:@style.Bottom; left:@style.Left; transform:@style.Transform;'>
                        <img src="@style.ImgSrc" alt="Icon" />
                    </button>
                }
            </div>
        </div>
    </div>

    @* Modal視窗 *@
    <div class="modal fade" id="portModal" tabindex="-1" aria-labelledby="portModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="portModalLabel">儲架設定</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="portform">
                        <div class="mb-3">
                            <label for="name" class="col-form-label">名稱:</label>
                            <input type="text" class="form-control" id="machinename" name="machinename">
                        </div>
                        <div class="mb-3">
                            <label for="code" class="col-form-label">機台條碼:</label>
                            <input type="text" class="form-control" id="interfacename" name="interfacename">
                        </div>
                        <div class="mb-3">
                            <label for="haveflag" class="col-form-label">儲架狀態:</label>
                            <select class="form-select" id="haveflag" name="haveflag">
                                <option value="0">空架</option>
                                <option value="1">空盤</option>
                                <option value="3">滿貨</option>
                            </select>
                        </div>
                        <div class="mb-3" id="workorder-container">
                            <label for="workorder" class="col-form-label">工單資訊:</label>
                            <input type="text" class="form-control" id="workorder" name="workorder">
                        </div>
                        <div class="mb-3">
                            <input type="checkbox" class="form-check-input" id="useflag" name="useflag">
                            <label class="form-check-label" for="useflag">啟用否</label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" id="submit" class="btn btn-primary" data-bs-target="#portModalToggle2" data-bs-toggle="modal">送出</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="portModalToggle2" aria-hidden="true" aria-labelledby="portModalToggleLabel2" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="portModalToggleLabel2"><strong>儲架設定</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    更新成功
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/port.js"></script>
}
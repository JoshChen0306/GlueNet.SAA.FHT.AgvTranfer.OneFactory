@if (ViewBag.Activation != null)
{
    @foreach (var shuttld in ViewBag.Activation)
    {
        <tr>
            @if (@shuttld.Date != null)
            {
                <td>@shuttld.Date</td>
            }           
            <td>@shuttld.ShuttleId</td>
            <td>@shuttld.Travling</td>
            <td>@shuttld.Idle</td>
            <td>@shuttld.Charging</td>
            <td>@shuttld.Alarm</td>
            <td>@shuttld.Offline</td>
            <td>@shuttld.NonTraveling</td>
            <td>@shuttld.Activation%</td>
        </tr>
    }
    @if (ViewBag.TotalActivation != null)
    {
        <tr>
            <td>合計：</td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td>@ViewBag.TotalActivation%</td>
        </tr>
    }
}


@foreach (var item in ViewBag.TaskStatus)
{
    <tr>
        <td class="align-middle">@item.ShuttleId</td>
        <td class="align-middle">@item.GustomerName</td>
        <td class="align-middle @item.Color"><strong class="Tasktype">@item.Description</strong></td>
        <td class="align-middle d-flex justify-content-center">
            <div class="battery">
                <div class="battery-level" style="width: @item.Battery%; background:@item.BatteryColor">
                    <span class="battery-level-text">@item.Battery%</span>
                </div>
            </div>
        </td>
        <td class="align-middle">@item.BeginStation</td>
        <td class="align-middle">@item.EndStation</td>
    </tr>
}

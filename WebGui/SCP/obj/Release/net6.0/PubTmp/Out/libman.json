{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "twitter-bootstrap@5.3.2",
      "destination": "wwwroot/bootstrap/"
    },
    {
      "provider": "unpkg",
      "library": "@microsoft/signalr@latest",
      "destination": "wwwroot/signalr/",
      "files": [
        "dist/browser/signalr.min.js",
        "dist/browser/signalr.js"
      ]
    },
    {
      "library": "microsoft-signalr@8.0.0",
      "destination": "wwwroot/microsoft-signalr/",
      "files": [
        "signalr.min.js",
        "signalr.js"
      ]
    }
  ]
}
@if (ViewBag.Missions != null)
{
    @foreach (var mission in ViewBag.Missions)
    {
        <tr>
            <td>@mission.Date</td>
            <td>@mission.ShuttleName</td>
            <td>@mission.DayShift</td>
            <td>@mission.NightShift</td>
            <td>@mission.Total</td>
        </tr>
    }
}


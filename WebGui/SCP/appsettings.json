    // 回送區 → 目的區（依序找空位）；鍵即為可 Release 的區域
    "ReleaseRoutes": {
      "K": [ "L" ],
      "M": [ "A" ],
      "B": [ "A" ]
    },
    // 人工帶料派送：起點區 → 允許目的區（後端檢查起點有貨、終點為空位且未被指派；未列出的區域不檢查）

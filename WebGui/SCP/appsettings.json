  "AutoDispatch": {
    "Enabled": true,
    "IntervalSeconds": 30,
    // 路線規則（AutoDispatchRouteEngine 逐條執行）
    // SourceHaveFlags：來源站視為有貨的 HaveFlag，未設定只認 "3"
    // SensorGuard：HaveFlag 與 RackId/WorkOrder 不一致的站點不派車並記 Warning
    // 註：.NET 設定會忽略空陣列，"Routes": [] 等同未設定（沿用 M→K）；要全部停用請改 Enabled=false
    "Routes": [
      { "Name": "路線6 M→K", "Enabled": true, "SourceBlocks": [ "M" ], "TargetBlocks": [ "K" ] },
      // R1/R4 待 T25 完成後再啟用
      // R1 物料：Sensor ON 寫 HaveFlag=1，T25 呼叫 status 補成 3＋WorkOrder=itemCode 後才派（只認 3）
      { "Name": "R1 中光電D→迅得2/3/4", "Enabled": false, "SourceBlocks": [ "D" ], "TargetBlocks": [ "E" ], "SourceHaveFlags": [ "3" ], "SensorGuard": true },
      // R4 空盤：不呼叫 status，Sensor ON 寫 HaveFlag=1 即派（2026-10-12 定案）
      { "Name": "R4 中光電A→迅得5/6/7", "Enabled": false, "SourceBlocks": [ "O" ], "TargetBlocks": [ "F" ], "SourceHaveFlags": [ "1" ], "SensorGuard": true },
      // R3 物料：L→B 跨樓層送達 B1（HaveFlag=3＋工單）後，中光電B 為空即派 1F 同樓層任務（2026-10-19 改自動，人員派發保留備援）
      // B 區啟用站只有 B1（B2～B5 UseFlag=N）；若日後啟用 B2～B5 會一併納入。AB 棟上線前停用，否則現行 B1 物料會被自動搬走
      { "Name": "R3 迅得1→中光電B", "Enabled": false, "SourceBlocks": [ "B" ], "TargetBlocks": [ "P" ], "SourceHaveFlags": [ "3" ], "SensorGuard": true },
      // R2 物料：D 送達 E 後由 OP 取走加工，加工完放回並在 SCP 登記（工單附加 ^DONE）才派；中光電C 為空才送（2026-10-19 改自動）
      // 建 oNeed 時移除 ^DONE，Mapping 的 itemCode 為人員登記的新工單。AB 棟上線前停用
      { "Name": "R2 迅得2/3/4→中光電C", "Enabled": false, "SourceBlocks": [ "E" ], "TargetBlocks": [ "Z" ], "SourceHaveFlags": [ "3" ], "SourceWorkOrderMarker": "^DONE", "SensorGuard": true },
      // R5 空盤：R4 送達 F 的空盤（HaveFlag=1）轉送 A1/A2（客戶圖「梯1、梯2」，2026-10-19 新增）；F 無 sensor 位址不開防呆
      // A 區啟用站只有 A1、A2（A3～A5 UseFlag=N）；若日後啟用 A3～A5 會一併納入。A1/A2 滿時每輪重查等待
      { "Name": "R5 迅得5/6/7→A1/A2", "Enabled": false, "SourceBlocks": [ "F" ], "TargetBlocks": [ "A" ], "SourceHaveFlags": [ "1" ], "SensorGuard": false }
    ]
  }

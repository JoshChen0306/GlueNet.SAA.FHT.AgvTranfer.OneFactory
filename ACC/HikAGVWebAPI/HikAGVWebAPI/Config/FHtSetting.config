<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="SectionDB" type="HikAGVWebAPI.SectionDB, HikAGVWebAPI"/>
    <section name="SectionLog" type="HikAGVWebAPI.SectionLog, HikAGVWebAPI"/>
    <section name="SectionFHt" type="HikAGVWebAPI.SectionFHt, HikAGVWebAPI"/>
    <section name="SectionElevator" type="HikAGVWebAPI.SectionElevator, HikAGVWebAPI"/>
    <section name="SectionSensorClear" type="HikAGVWebAPI.SectionSensorClear, HikAGVWebAPI"/>
    <section name="SectionCgdWcs" type="HikAGVWebAPI.SectionCgdWcs, HikAGVWebAPI"/>
    <section name="SectionLampOutput" type="HikAGVWebAPI.SectionLampOutput, HikAGVWebAPI"/>
  </configSections>

  <SectionDB>
    <DBSettings DBIP="127.0.0.1" DBName="agvDB_1400004_1" UserID="mcs" Password="Zz123456" />
  </SectionDB>

  <SectionLog>
    <LogSettings LogPath="C:\Logs\" KeepDate="60" />
  </SectionLog>

  <SectionFHt>
    <FHtSettings ContentType="application/x-www-form-urlencoded" WebURL="http://172.16.10.21//API//TeamService.ashx?ask=postMessage" Teamcode="291" APIAccount="va_2fd8dfef3c1d4c5293" APIKey="fd337716-fb34-4ee8-9f3a-55aec9a37fad" LowBattery="40,25" TestMode="false" />
  </SectionFHt>

  <SectionElevator>
    <ElevatorSettings 
      CustomerElevatorFloors="1F,2F,3F"
      CustomerElevatorWaitPoints="1F:U1,2F:V1,3F:W1"
      CustomerElevatorInsidePoints="1F:U2,2F:V2,3F:W2"
      FreightElevatorFloors="3F,4F"
      FreightElevatorWaitPoints="3F:X1,4F:Y1"
      FreightElevatorInsidePoints="3F:X2,4F:Y2"
      StationFloorMapping="A:1F,B:1F,C:1F,D:1F,E:1F,F:1F,O:1F,P:1F,Z:1F,K:3F,L:3F,M:3F" />
  </SectionElevator>

  <SectionSensorClear>
    <!-- Enable：總開關；StationNumber：MX Component Logical Station No；
         PollIntervalMs：輪詢間隔(ms)；ConfirmCount：連續確認輪數(去抖)；
         SensorMap："PLC位址:庫位StationNo"，逗號分隔可多筆；⚠️ 點位以 DB oPortPlc 為準（T29），
           SensorMap 只在 oPortPlc 資料表不存在或沒有資料時使用（升級過渡期）。改點位請改 oPortPlc 後重啟 ACC；
         SensorOnStations：中光電來源站，Sensor ON 且 HaveFlag=0 時寫 HaveFlag=1、Sensor OFF 清空時刪除未派出 oNeed -->
    <SensorClearSettings Enable="true" StationNumber="1" PollIntervalMs="1000" ConfirmCount="3" SensorMap="M10:B1" SensorOnStations="D1,O1" />
  </SectionSensorClear>

  <SectionCgdWcs>
    <!-- 中光電儲位 API 介接（T25）：Enable：總開關；BaseUrl：中光電 WCS（正式 URL 待聯測前確認，目前指向假 Server）；
         TimeoutMs：單次逾時；RetryDelaysSec：release／Mapping 失敗重試間隔（秒）；
         BinCodeMap："我方站號:中光電binCode"（binCode 為暫定值，正式值到位後只改這裡）；
         StatusStations：需查 status 補資料的來源站（R1 物料 D1；R4 空盤 O1 不查）；StatusPollMs：補資料輪詢間隔 -->
    <CgdWcsSettings Enable="false" BaseUrl="http://localhost:5080" TimeoutMs="5000" RetryDelaysSec="5,15,60"
      BinCodeMap="O1:CGD-A,P1:CGD-B,Z1:CGD-C,D1:CGD-D" StatusStations="D1" StatusPollMs="10000" />
  </SectionCgdWcs>

  <SectionLampOutput>
    <!-- 三色燈輸出（T18）：Enable：總開關（預設 false）；StationNumber：MX Component Logical Station No；PollIntervalMs：讀 oPort 間隔(ms)
         點位與各站啟用旗標在 DB oPortPlc（LampGreen/LampYellow/LampRed、LampUseFlag），改點位後重啟 ACC。
         燈號（T16 暫定）：HaveFlag 0 → 綠、1/2 → 黃、3 → 紅。⚠️ 位址未經迅得確認前不可啟用（寫入未規劃 M bit 會干擾 PLC） -->
    <LampOutputSettings Enable="false" StationNumber="1" PollIntervalMs="2000" />
  </SectionLampOutput>
</configuration>